[Unit]
Description=Javelin Pro Flask API
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mybackend_bh
Environment=PATH=/home/ubuntu/mybackend_bh/venv/bin
ExecStart=/home/ubuntu/mybackend_bh/venv/bin/gunicorn -w 1 -b 127.0.0.1:8000 app:app --timeout 300
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
